NODE_ENV=development
PORT=3000
# Leave blank for TCP development. Production can listen on this Unix socket.
SOCKET_PATH=
BASE_PATH=/repo
BASE_URL=http://127.0.0.1:3000/repo
COURSE_HOMEWORK_URL=/fa26/hw/
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=

GITHUB_ORG=cal-cs184-student
# From the identity-only GitHub App. It must have no repository,
# organization, or enterprise permissions.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# From the separately installed provisioning GitHub App.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=

DATA_FILE=./data/repo184.json
DEV_FAKE_GITHUB=0
